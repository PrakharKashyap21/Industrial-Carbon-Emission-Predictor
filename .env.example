# Industrial Carbon Emission System — Environment Configuration Template

# Application Environment (development, testing, production)
APP_ENV=production

# Database Configuration
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@postgres:5432/industrial_carbon_db
DB_NAME=industrial_carbon_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# JWT Authentication Security (MUST replace secret key in production)
JWT_SECRET_KEY=industrial_carbon_intelligence_super_secret_jwt_key_32bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS Configuration
CORS_ORIGINS=["http://localhost","http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=http://localhost:8000/api
